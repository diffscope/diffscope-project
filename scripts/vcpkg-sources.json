{
    "manifest-dir": "vcpkg-manifest",
    "vcpkg": {
        "repository": "https://github.com/microsoft/vcpkg.git",
        "ref": "39344dff01c5a5a0134caf2624cdd492f05d30ea"
    },
    "overlays": [
        {
            "path": "vcpkg-overrides"
        },
        {
            "repository": "../../stdware/vcpkg-overlay.git",
            "ref": "4155714011740456527f8ec4bfe53a26b46e54c2"
        }
    ],
    "tasks": {
