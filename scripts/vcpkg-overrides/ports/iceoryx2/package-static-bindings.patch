+    if(EXISTS "${_iceoryx2_ffi_debug}")
+        set_property(TARGET iceoryx2-c::ffi-static APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
+        set_property(TARGET iceoryx2-c::ffi-static PROPERTY IMPORTED_LOCATION_DEBUG "${_iceoryx2_ffi_debug}")
+    endif()
+    unset(_iceoryx2_ffi_debug)
+endif()
+
