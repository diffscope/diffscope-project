if(VCPKG_RUST_HOST_TARGET)
    set(rust_target "${VCPKG_RUST_HOST_TARGET}")
else()
    set(rust_arch "${VCPKG_TARGET_ARCHITECTURE}")
    if(rust_arch STREQUAL "x64")
        set(rust_arch x86_64)
    elseif(rust_arch STREQUAL "x86")
        set(rust_arch i686)
    elseif(rust_arch STREQUAL "arm64")
        set(rust_arch aarch64)
    elseif(rust_arch STREQUAL "riscv64")
        set(rust_arch riscv64gc)
    elseif(rust_arch STREQUAL "ppc64le")
        set(rust_arch powerpc64le)
    endif()

    if(VCPKG_TARGET_IS_MINGW)
        if(rust_arch STREQUAL "aarch64")
            set(rust_platform pc-windows-gnullvm)
        else()
            set(rust_platform pc-windows-gnu)
        endif()
    elseif(VCPKG_TARGET_IS_WINDOWS AND NOT VCPKG_TARGET_IS_UWP AND NOT VCPKG_TARGET_IS_XBOX)
        set(rust_platform pc-windows-msvc)
    elseif(VCPKG_TARGET_IS_LINUX AND NOT rust_arch STREQUAL "arm")
        set(rust_platform unknown-linux-gnu)
    elseif(VCPKG_TARGET_IS_OSX)
        set(rust_platform apple-darwin)
    elseif(VCPKG_TARGET_IS_FREEBSD)
        set(rust_platform unknown-freebsd)
    elseif(VCPKG_TARGET_IS_NETBSD)
        set(rust_platform unknown-netbsd)
    elseif(VCPKG_TARGET_IS_SOLARIS)
        set(rust_platform pc-solaris)
    endif()

    if(NOT rust_platform)
        message(FATAL_ERROR "Cannot select a Rust host toolchain for ${TARGET_TRIPLET}. Set VCPKG_RUST_HOST_TARGET in the host triplet.")
    endif()
    set(rust_target "${rust_arch}-${rust_platform}")
endif()

file(READ "${CURRENT_PORT_DIR}/toolchain-checksums.json" rust_checksums)
string(JSON toolchain ERROR_VARIABLE unsupported_host GET "${rust_checksums}" "${rust_target}")
if(unsupported_host)
    message(FATAL_ERROR "Rust ${VERSION} has no packaged host toolchain for ${rust_target}. Set VCPKG_RUST_HOST_TARGET to a published host triple in the host triplet.")
endif()

set(VCPKG_FIXUP_MACHO_RPATH OFF)
set(rust_root "${CURRENT_PACKAGES_DIR}/tools/${PORT}")
foreach(component IN ITEMS rustc cargo rust-std)
    set(archive_name "${component}-${VERSION}-${rust_target}.tar.xz")
    set(download_args
        URLS "https://static.rust-lang.org/dist/2025-12-11/${archive_name}"
        FILENAME "${archive_name}"
    )
    string(JSON checksum GET "${toolchain}" "${component}")
    string(LENGTH "${checksum}" checksum_length)
    if(checksum_length EQUAL 128)
        vcpkg_download_distfile(archive ${download_args} SHA512 "${checksum}")
    else()
        # Verify the Rust release manifest's SHA256 before extracting the archive.
        vcpkg_download_distfile(archive ${download_args} SKIP_SHA512)
        file(SHA256 "${archive}" actual_checksum)
        if(NOT actual_checksum STREQUAL checksum)
            message(FATAL_ERROR "SHA256 mismatch for ${archive}.")
        endif()
    endif()
    vcpkg_extract_source_archive(source_path ARCHIVE "${archive}")
    file(STRINGS "${source_path}/components" component_directory LIMIT_COUNT 1)
    file(COPY "${source_path}/${component_directory}/"
        DESTINATION "${rust_root}"
        PATTERN "manifest.in" EXCLUDE
    )
    list(APPEND rust_licenses "${source_path}/LICENSE-APACHE" "${source_path}/LICENSE-MIT")
    if(EXISTS "${source_path}/COPYRIGHT")
        list(APPEND rust_licenses "${source_path}/COPYRIGHT")
    endif()
endforeach()

file(WRITE "${rust_root}/target.txt" "${rust_target}\n")
vcpkg_install_copyright(FILE_LIST ${rust_licenses})
