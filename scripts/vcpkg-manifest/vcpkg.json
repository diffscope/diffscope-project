{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "dependencies": [
        "breakpad",
        "qastool",
        "qnrbf",
        "stdutau",
        "extensionsystem",
        "qwindowkit",
        "stdcorelib",
        "qbreakpad",
        "libsndfile",
        "rpclib",
        "rtmidi",
        {
            "name": "asiosdk",
            "platform": "windows"
        },
        {
            "name": "pipewire",
            "platform": "linux"
        },
        {
            "name": "pulseaudio",
            "platform": "linux"
        },
        {
            "name": "jack2",
            "platform": "linux"
        },
        {
            "name": "alsa",
            "platform": "linux"
        },
        "interval-tree",
        "boost-interprocess",
        "wavpack",
        "neargye-semver",
        "r8brain-free-src",
        {
            "name": "glib",
            "platform": "linux"
        },
        {
            "name": "icu",
            "platform": "!osx"
        },
        "wolf-midi",
        "zstd",
        "opendspx",
        {
            "name": "libarchive",
            "default-features": false,
            "features": [
                "lzma"
            ]
        },
        "xxhash",
        "signalsmith-dsp",
        "rubberband"
    ],
    "vcpkg-configuration": {
        "overlay-ports": [
            "../vcpkg/ports"
        ],
        "overlay-triplets": [
            "../vcpkg/triplets"
        ]
    }
}
