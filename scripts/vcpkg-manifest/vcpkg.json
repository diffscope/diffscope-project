{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "dependencies": [
        "extensionsystem",
        "qwindowkit",
        "stdcorelib",
        "qbreakpad",
        "libsndfile",
        "rtmidi",
        {
            "name": "asiosdk",
            "platform": "windows"
        },
        {
            "name": "pipewire",
            "platform": "linux"
        },
        {
            "name": "pulseaudio",
            "platform": "linux"
        },
        {
            "name": "jack2",
            "platform": "linux"
        },
        {
            "name": "alsa",
            "platform": "linux"
        },
        "interval-tree",
        "wavpack",
        "neargye-semver",
        "r8brain-free-src",
        {
            "name": "glib",
            "platform": "linux"
        },
        "icu",
        "opendspx",
        {
            "name": "libarchive",
            "default-features": false,
            "features": [
                "lzma"
            ]
        },
        "xxhash",
        "signalsmith-dsp",
        "rubberband",
        {
            "name": "qiconmaker",
            "platform": "windows | osx"
        },
        "i18next"
    ],
    "features": {
        "test": {
            "description": "Dependencies for tests",
            "dependencies": [
                "gtest",
                "benchmark"
            ]
        }
    }
}
