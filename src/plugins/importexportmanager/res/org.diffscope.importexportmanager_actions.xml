<actionExtension xmlns:diffscope="http://schemas.diffscope.org/diffscope/actions/diffscope">
    <version>1.0</version>
    <id>org.diffscope.importexportmanager</id>
    <configuration>
        <defaultCatalog>core.mainMenu</defaultCatalog>
        <translationContext
                text="Application::ActionText"
                category="Application::ActionClass"
                description="Application::ActionDescription"
        />
        <vars>
            <var key="APP_NAME" value="DiffScope" />
        </vars>
    </configuration>

    <items>
        <phony id="core.mainMenu" />

        <action id="org.diffscope.importexportmanager.file.&amp;import" category="File" icon="document_arrow_right" triggerable="false" diffscope:componentType="menu" />
        <action id="org.diffscope.importexportmanager.file.&amp;export" category="File" icon="document_arrow_left" triggerable="false" diffscope:componentType="menu" />
        <action id="org.diffscope.importexportmanager.project.importAsTracks" category="Project" text="Import Tracks from File" icon="document_arrow_right" triggerable="false" diffscope:componentType="menu" />
        <action id="org.diffscope.importexportmanager.edit.copySpecial^" category="Edit" shortcut="Ctrl+Alt+C" />
        <action id="org.diffscope.importexportmanager.edit.pasteSpecial^" category="Edit" shortcut="Ctrl+Alt+V" />

        <action id="org.diffscope.importexportmanager.panel.import" category="Panel" catalog="org.diffscope.core.workspacePanelWidgets" icon="document_arrow_right" triggerable="false" diffscope:componentType="custom" />

        <group id="org.diffscope.importexportmanager.importExportActions" />
        <group id="org.diffscope.importexportmanager.importActions" />
        <group id="org.diffscope.importexportmanager.importTracksActions" />
        <phony id="org.diffscope.core.workspacePanelWidgets" />
    </items>

    <layouts>
        <group id="org.diffscope.importexportmanager.importExportActions">
            <action id="org.diffscope.importexportmanager.file.import" />
            <action id="org.diffscope.importexportmanager.file.export" />
        </group>
        <group id="org.diffscope.importexportmanager.importActions">
            <action id="org.diffscope.importexportmanager.file.import" />
        </group>
        <group id="org.diffscope.importexportmanager.importTracksActions">
            <action id="org.diffscope.importexportmanager.project.importAsTracks" />
        </group>
    </layouts>

    <insertions>
        <insertion target="org.diffscope.core.file" anchor="after" relativeTo="org.diffscope.core.fileSaveActions">
            <group id="org.diffscope.importexportmanager.importExportActions" />
        </insertion>
        <insertion target="org.diffscope.core.homeFile" anchor="after" relativeTo="org.diffscope.core.fileOpenActions">
            <group id="org.diffscope.importexportmanager.importActions" />
        </insertion>
        <insertion target="org.diffscope.core.edit.generic" anchor="after" relativeTo="org.diffscope.core.edit.copy">
            <action id="org.diffscope.importexportmanager.edit.copySpecial" />
        </insertion>
        <insertion target="org.diffscope.core.edit.generic" anchor="after" relativeTo="org.diffscope.core.edit.paste">
            <action id="org.diffscope.importexportmanager.edit.pasteSpecial" />
        </insertion>
        <insertion target="org.diffscope.core.homePanels" anchor="last">
            <action id="org.diffscope.importexportmanager.panel.import" />
        </insertion>
        <insertion target="org.diffscope.core.insert" anchor="last">
            <group id="org.diffscope.importexportmanager.importTracksActions" />
        </insertion>
        <insertion target="org.diffscope.core.trackSceneContextMenu" anchor="after" relativeTo="org.diffscope.core.insert.insertTrack">
            <group id="org.diffscope.importexportmanager.importTracksActions" />
        </insertion>
    </insertions>

</actionExtension>
