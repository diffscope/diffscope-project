<actionExtension xmlns:diffscope="http://schemas.diffscope.org/diffscope/actions/diffscope">
    <version>1.0</version>
    <id>org.diffscope.synthvisualizer</id>
    <configuration>
        <defaultCatalog>org.diffscope.core.mainMenu</defaultCatalog>
        <translationContext
                text="Application::ActionText"
                category="Application::ActionClass"
                description="Application::ActionDescription"
        />
        <vars>
            <var key="APP_NAME" value="DiffScope" />
        </vars>
    </configuration>

    <items>
        <phony id="org.diffscope.core.mainMenu" />

        <action
                id="org.diffscope.synthvisualizer.pianoRollPanel.additionalTracks.synthesisPieces"
                category="Additional Tracks"
                catalog="org.diffscope.visualeditor.pianoRollPanel.additionalTrackWidgets"
                text="Synthesis Pieces"
                icon=""
                triggerable="false"
                diffscope:componentType="custom"
        />

        <phony id="org.diffscope.visualeditor.pianoRollPanel.additionalTrackWidgets" />
    </items>

    <layouts>
    </layouts>

    <insertions>
    </insertions>
</actionExtension>
