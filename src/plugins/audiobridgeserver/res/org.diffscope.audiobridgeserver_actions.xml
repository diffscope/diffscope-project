<actionExtension xmlns:diffscope="http://schemas.diffscope.org/diffscope/actions/diffscope">
    <version>1.0</version>
    <id>org.diffscope.audiobridgeserver</id>
    <configuration>
        <defaultCatalog>org.diffscope.core.mainStatusBar</defaultCatalog>
        <translationContext
            text="Application::ActionText"
            category="Application::ActionClass"
        />
    </configuration>
    <items>
        <phony id="org.diffscope.core.mainStatusBar" />
        <action id="org.diffscope.audiobridgeserver.managedProjectStatus"
                text="Managed by DiffScope Bridge" icon="plug_connected"
                triggerable="false" diffscope:componentType="widget" />
        <action id="org.diffscope.audiobridgeserver.downloadBridge"
                text="Download DiffScope Bridge" category="Help" icon="plug_connected" />
        <group id="org.diffscope.audiobridgeserver.helpActions" />
    </items>
    <layouts>
        <group id="org.diffscope.audiobridgeserver.helpActions">
            <action id="org.diffscope.audiobridgeserver.downloadBridge" />
        </group>
    </layouts>
    <insertions>
        <insertion target="org.diffscope.core.mainStatusBar" anchor="first">
            <action id="org.diffscope.audiobridgeserver.managedProjectStatus" />
        </insertion>
        <insertion target="org.diffscope.core.help" anchor="last">
            <group id="org.diffscope.audiobridgeserver.helpActions" />
        </insertion>
    </insertions>
</actionExtension>
