<actionExtension xmlns:diffscope="http://schemas.diffscope.org/diffscope/actions/diffscope">
    <version>1.0</version>
    <id>org.diffscope.synth</id>
    <configuration>
        <defaultCatalog>core.mainMenu</defaultCatalog>
        <translationContext
                text="Application::ActionText"
                category="Application::ActionClass"
                description="Application::ActionDescription"
        />
    </configuration>
    <items>
        <phony id="core.mainMenu" />

        <action id="org.diffscope.synth.welcomeWizard.synthesisEnvironment" text="Synthesis Environment" textTr="SynthesisEnvironmentWelcomeWizardPage" triggerable="false" diffscope:componentType="custom" />

        <menu id="org.diffscope.synth.dssp" text="DiffSinger Synthesis Program" icon="dssp" description="Control the local DiffSinger Synthesis Program service." />
        <action
                id="org.diffscope.synth.dssp.statusMenuItem"
                category="Synth"
                text="DiffSinger Synthesis Program Status Menu Item"
                triggerable="false"
                diffscope:componentType="widget"
        />
        <action id="org.diffscope.synth.dssp.start" category="Synth" text="Start" icon="play" />
        <action id="org.diffscope.synth.dssp.stop" category="Synth" text="Stop" icon="stop" />
        <action id="org.diffscope.synth.dssp.restart" category="Synth" text="Restart" icon="arrow_clockwise" />
        <action id="org.diffscope.synth.dssp.settings" category="Synth" text="Settings..." icon="settings" />
        <action id="org.diffscope.synth.packageManager" text="Package Manager" category="Preferences" icon="box" />
        <action
                id="org.diffscope.synth.dssp.status"
                category="Synth"
                text="DiffSinger Synthesis Program Status"
                triggerable="false"
                diffscope:componentType="widget"
        />

        <menu id="org.diffscope.synth.extract" text="Audio Extraction" description="Choose an extraction task for the current audio clip." />
        <action id="org.diffscope.synth.extract.notes" category="Extract" text="Extract Notes..." description="Create an editable singing clip from the current audio clip." />
        <action id="org.diffscope.synth.extract.tempo" category="Extract" text="Extract Tempo..." description="Apply the tempo of the current audio clip to the project." />
        <action id="org.diffscope.synth.extract.separation" category="Extract" text="Separate Audio..." description="Split the current audio clip into separate audio tracks." />
        <action
                id="org.diffscope.synth.panel.services"
                category="Panel"
                text="Synthesis Services"
                icon="music_note_2_pulse"
                catalog="org.diffscope.core.workspacePanelWidgets"
                triggerable="false"
                diffscope:componentType="custom"
        />
        <action id="org.diffscope.synth.panel.services.show" category="Panel" text="Show Synthesis Services" />
        <action
                id="org.diffscope.synth.status"
                category="Synth"
                text="Synthesis Status"
                triggerable="false"
                diffscope:componentType="widget"
        />
        <action
                id="org.diffscope.synth.resynthesize"
                category="Synth"
                text="&amp;Resynthesize..."
                icon="arrow_sync"
                description="Choose which synthesis stages to rerun for the selected clips or notes."
        />

        <group id="org.diffscope.synth.statusIndicators" text="Synthesis Status Indicators" />
        <group id="org.diffscope.synth.synthesisActions" />
        <phony id="org.diffscope.core.workspacePanelWidgets" />
    </items>

    <layouts>
        <menu id="org.diffscope.synth.dssp">
            <action id="org.diffscope.synth.dssp.statusMenuItem" />
            <separator />
            <action id="org.diffscope.synth.dssp.start" />
            <action id="org.diffscope.synth.dssp.stop" />
            <action id="org.diffscope.synth.dssp.restart" />
            <separator />
            <action id="org.diffscope.synth.dssp.settings" />
        </menu>
        <menu id="org.diffscope.synth.extract">
            <action id="org.diffscope.synth.extract.notes" />
            <action id="org.diffscope.synth.extract.tempo" />
            <action id="org.diffscope.synth.extract.separation" />
        </menu>
        <group id="org.diffscope.synth.statusIndicators">
            <action id="org.diffscope.synth.dssp.status" />
            <action id="org.diffscope.synth.status" />
        </group>
        <group id="org.diffscope.synth.synthesisActions">
            <action id="org.diffscope.synth.resynthesize" />
        </group>
    </layouts>

    <insertions>
        <insertion target="org.diffscope.welcomewizard.pages" anchor="last">
            <action id="org.diffscope.synth.welcomeWizard.synthesisEnvironment" />
        </insertion>
        <insertion target="org.diffscope.core.preferenceActions" anchor="last">
            <menu id="org.diffscope.synth.dssp" />
            <action id="org.diffscope.synth.packageManager" />
        </insertion>
        <insertion target="org.diffscope.audio.audioProcessingActions" anchor="last">
            <menu id="org.diffscope.synth.extract" />
        </insertion>
        <insertion
                target="org.diffscope.core.mainStatusBar"
                anchor="before"
                relativeTo="org.diffscope.core.selectionIndicator"
        >
            <group id="org.diffscope.synth.statusIndicators" />
        </insertion>
        <insertion
                target="org.diffscope.core.edit"
                anchor="after"
                relativeTo="org.diffscope.core.edit.editCurrentClipActions"
        >
            <group id="org.diffscope.synth.synthesisActions" />
        </insertion>
        <insertion
                target="org.diffscope.core.clipItemContextMenu"
                anchor="before"
                relativeTo="org.diffscope.core.genericItemContextMenuActions"
        >
            <group id="org.diffscope.synth.synthesisActions" />
        </insertion>
        <insertion
                target="org.diffscope.core.noteItemContextMenu"
                anchor="before"
                relativeTo="org.diffscope.core.genericItemContextMenuActions"
        >
            <group id="org.diffscope.synth.synthesisActions" />
        </insertion>
    </insertions>
</actionExtension>
