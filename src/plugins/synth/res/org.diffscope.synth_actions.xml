<actionExtension xmlns:diffscope="http://schemas.diffscope.org/diffscope/actions/diffscope">
    <version>1.0</version>
    <id>org.diffscope.synth</id>
    <configuration>
        <defaultCatalog>core.mainMenu</defaultCatalog>
        <translationContext
                text="Application::ActionText"
                class="Application::ActionClass"
                description="Application::ActionDescription"
        />
    </configuration>
    <items>
        <action
                id="org.diffscope.synth.panel.services"
                text="Synthesis Services"
                icon="music_note_2_pulse"
                catalog="org.diffscope.core.workspacePanelWidgets"
                diffscope:uniquePanel="true"
                diffscope:componentType="custom"
        />
        <action
                id="org.diffscope.synth.status"
                text="Synthesis Status"
                diffscope:componentType="widget"
        />
        <action
                id="org.diffscope.synth.resynthesize"
                text="&amp;Resynthesize..."
                icon="arrow_sync"
        />
    </items>

    <layouts>
        <group id="org.diffscope.synth.synthesisActions">
            <action id="org.diffscope.synth.resynthesize" />
        </group>
    </layouts>

    <insertions>
        <insertion
                target="org.diffscope.core.mainStatusBar"
                anchor="before"
                relativeTo="org.diffscope.core.selectionIndicator"
        >
            <action id="org.diffscope.synth.status" />
        </insertion>
        <insertion
                target="org.diffscope.core.edit"
                anchor="after"
                relativeTo="org.diffscope.core.edit.editCurrentClipActions"
        >
            <group id="org.diffscope.synth.synthesisActions" />
        </insertion>
        <insertion
                target="org.diffscope.core.clipItemContextMenu"
                anchor="before"
                relativeTo="org.diffscope.core.genericItemContextMenuActions"
        >
            <group id="org.diffscope.synth.synthesisActions" />
        </insertion>
        <insertion
                target="org.diffscope.core.noteItemContextMenu"
                anchor="before"
                relativeTo="org.diffscope.core.genericItemContextMenuActions"
        >
            <group id="org.diffscope.synth.synthesisActions" />
        </insertion>
    </insertions>
</actionExtension>
