<actionExtension xmlns:diffscope="http://schemas.diffscope.org/diffscope/actions/diffscope">
    <version>1.0</version>
    <id>org.diffscope.pitchshifter</id>
    <configuration>
        <defaultCatalog>org.diffscope.core.mainMenu</defaultCatalog>
        <translationContext
                text="Application::ActionText"
                class="Application::ActionClass"
                description="Application::ActionDescription"
        />
        <vars>
            <var key="APP_NAME" value="DiffScope" />
        </vars>
    </configuration>

    <items>
        <action id="org.diffscope.pitchshifter.edit.shiftPitch" text="Stretch and Shift Pitch..." />
    </items>

    <insertions>
        <insertion target="org.diffscope.audio.audioProcessingActions" anchor="last">
            <action id="org.diffscope.pitchshifter.edit.shiftPitch" />
        </insertion>
    </insertions>
</actionExtension>
