<actionExtension xmlns:diffscope="http://schemas.diffscope.org/diffscope/actions/diffscope">
    <version>1.0</version>
    <id>org.diffscope.visualeditor</id>
    <configuration>
        <defaultCatalog>core.mainMenu</defaultCatalog>
        <translationContext
                text="Application::ActionText"
                category="Application::ActionClass"
                description="Application::ActionDescription"
        />
        <vars>
            <var key="APP_NAME" value="DiffScope" />
        </vars>
    </configuration>

    <items>
        <phony id="core.mainMenu" />

        <action id="org.diffscope.visualeditor.view.scrollUp" category="View" icon="arrow_up" shortcut="Ctrl+Up" />
        <action id="org.diffscope.visualeditor.view.scrollDown" category="View" icon="arrow_down" shortcut="Ctrl+Down" />
        <action id="org.diffscope.visualeditor.view.scrollLeft" category="View" icon="arrow_left" shortcut="Ctrl+Left" />
        <action id="org.diffscope.visualeditor.view.scrollRight" category="View" icon="arrow_right" shortcut="Ctrl+Right" />
        <action id="org.diffscope.visualeditor.view.scrollUpPage" category="View" icon="chevron_double_up" shortcut="PgUp" />
        <action id="org.diffscope.visualeditor.view.scrollDownPage" category="View" icon="chevron_double_down" shortcut="PgDown" />
        <action id="org.diffscope.visualeditor.view.scrollLeftPage" category="View" icon="chevron_double_left" shortcut="Alt+PgUp" />
        <action id="org.diffscope.visualeditor.view.scrollRightPage" category="View" icon="chevron_double_right" shortcut="Alt+PgDown" />
        <action id="org.diffscope.visualeditor.view.scrollToTop" category="View" icon="arrow_import_up" shortcut="Ctrl+Home" />
        <action id="org.diffscope.visualeditor.view.scrollToBottom" category="View" icon="arrow_import_down" shortcut="Ctrl+End" />
        <action id="org.diffscope.visualeditor.view.scrollToLeftmost" category="View" icon="arrow_import_left" shortcut="Ctrl+Alt+Home" />
        <action id="org.diffscope.visualeditor.view.scrollToRightmost" category="View" icon="arrow_import_right" shortcut="Ctrl+Alt+End" />
        <action id="org.diffscope.visualeditor.view.scrollToPlaybackPosition" category="View" shortcut="Ctrl+Y" />
        <action id="org.diffscope.visualeditor.view.scrollToCurrentItem" category="View" shortcut="Ctrl+\\" />
        <action id="org.diffscope.visualeditor.view.verticalZoomIn" category="View" icon="zoom_in" shortcut="Ctrl+=" />
        <action id="org.diffscope.visualeditor.view.verticalZoomOut" category="View" icon="zoom_out" shortcut="Ctrl+-" />
        <action id="org.diffscope.visualeditor.view.horizontalZoomIn" category="View" icon="zoom_in" shortcut="Ctrl+Alt+=" />
        <action id="org.diffscope.visualeditor.view.horizontalZoomOut" category="View" icon="zoom_out" shortcut="Ctrl+Alt+-" />
        <action id="org.diffscope.visualeditor.view.resetVerticalScale" category="View" icon="arrow_autofit_height" shortcut="Ctrl+Shift+R" />
        <action id="org.diffscope.visualeditor.view.resetHorizontalScale" category="View" icon="arrow_autofit_width" shortcut="Ctrl+Alt+Shift+R" />

        <action id="org.diffscope.visualeditor.arrangementPanel.pointerTool" category="Arrangement Panel" icon="cursor" />
        <action id="org.diffscope.visualeditor.arrangementPanel.pencilTool" category="Arrangement Panel" icon="edit" />
        <action id="org.diffscope.visualeditor.arrangementPanel.scissorTool" category="Arrangement Panel" icon="cut" />
        <action id="org.diffscope.visualeditor.arrangementPanel.selectTool" category="Arrangement Panel" icon="rectangle_landscape_dash" />
        <action id="org.diffscope.visualeditor.arrangementPanel.handTool" category="Arrangement Panel" icon="hand_left" />
        <action id="org.diffscope.visualeditor.mixerPanel.pointerTool" category="Mixer Panel" icon="cursor" />
        <action id="org.diffscope.visualeditor.mixerPanel.handTool" category="Mixer Panel" icon="hand_left" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.pointerTool" category="Piano Roll Panel" icon="cursor" shortcut="F5" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.pencilTool" category="Piano Roll Panel" icon="edit" shortcut="F6" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.scissorTool" category="Piano Roll Panel" icon="cut" shortcut="F7" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.selectTool" category="Piano Roll Panel" icon="rectangle_landscape_dash" shortcut="F8" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.handTool" category="Piano Roll Panel" icon="hand_left" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.pitchPencilTool" category="Piano Roll Panel" icon="pitch_pencil" shortcut="1" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.pitchLineTool" category="Piano Roll Panel" icon="line" shortcut="2" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.pitchFixingTool" category="Piano Roll Panel" icon="paint_brush_arrow_down" shortcut="3" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.pitchEraserTool" category="Piano Roll Panel" icon="pitch_erase" shortcut="4" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.pitchRangeSelectTool" category="Piano Roll Panel" icon="pitch_cursor_text" shortcut="5" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.pitchPointerTool" category="Piano Roll Panel" icon="pitch_cursor" shortcut="6" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.pitchPenTool" category="Piano Roll Panel" icon="calligraphy_pen" shortcut="7" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.pitchConvertTool" category="Piano Roll Panel" icon="arrow_bidirectional_left_right" shortcut="8" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.pitchAnchorSelectTool" category="Piano Roll Panel" icon="pitch_rectangle_landscape_dash" shortcut="9" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.additionalTracks" category="Piano Roll Panel" icon="more_vertical" triggerable="false" diffscope:componentType="menu" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.bottomAdditionalTracks" category="Piano Roll Panel" text="Bottom Panels" icon="layout_row_two_focus_bottom" triggerable="false" diffscope:componentType="menu" />
        <action id="org.diffscope.visualeditor.arrangementPanel.snap" category="Arrangement Panel" triggerable="false" diffscope:componentType="widget" />
        <action id="org.diffscope.visualeditor.arrangementPanel.snapDuration" category="Arrangement Panel" triggerable="false" diffscope:componentType="menu" />
        <action id="org.diffscope.visualeditor.arrangementPanel.snapTuplet" category="Arrangement Panel" triggerable="false" diffscope:componentType="menu" />
        <action id="org.diffscope.visualeditor.arrangementPanel.autoPageScrolling" category="Arrangement Panel" icon="playhead_panel_chevron_double" />
        <action id="org.diffscope.visualeditor.arrangementPanel.additionalTracks" category="Arrangement Panel" icon="more_vertical" triggerable="false" diffscope:componentType="menu" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.snap" category="Piano Roll Panel" triggerable="false" diffscope:componentType="widget" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.snapDuration" category="Piano Roll Panel" triggerable="false" diffscope:componentType="menu" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.snapTuplet" category="Piano Roll Panel" triggerable="false" diffscope:componentType="menu" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.autoPageScrolling" category="Piano Roll Panel" icon="playhead_panel_chevron_double" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.editingClip" category="Piano Roll Panel" triggerable="false" diffscope:componentType="widget" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.highlightScale" category="Piano Roll Panel" icon="highlight" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.showTrackSelector" category="Piano Roll Panel" icon="navigation" />

        <action id="org.diffscope.visualeditor.panel.arrangement" category="Panel" catalog="org.diffscope.core.workspacePanelWidgets" icon="gantt_chart" triggerable="false" diffscope:componentType="custom"/>
        <action id="org.diffscope.visualeditor.panel.arrangement.show" category="Panel" text="Show Arrangement" />
        <action id="org.diffscope.visualeditor.panel.mixer" category="Panel" catalog="org.diffscope.core.workspacePanelWidgets" icon="options_vertical" triggerable="false" diffscope:componentType="custom"/>
        <action id="org.diffscope.visualeditor.panel.mixer.show" category="Panel" text="Show Mixer" />
        <action id="org.diffscope.visualeditor.panel.pianoRoll" category="Panel" catalog="org.diffscope.core.workspacePanelWidgets" icon="midi" triggerable="false" diffscope:componentType="custom"/>
        <action id="org.diffscope.visualeditor.panel.pianoRoll.show" category="Panel" text="Show Piano Roll" />

        <phony id="org.diffscope.visualeditor.arrangementPanel.additionalTrackWidgets" />
        <phony id="org.diffscope.visualeditor.pianoRollPanel.additionalTrackWidgets" />
        <phony id="org.diffscope.visualeditor.pianoRollPanel.bottomAdditionalTrackWidgets" />

        <action id="org.diffscope.visualeditor.arrangementPanel.additionalTracks.label" category="Additional Tracks" catalog="org.diffscope.visualeditor.arrangementPanel.additionalTrackWidgets" icon="tag" triggerable="false" diffscope:componentType="custom" />
        <action id="org.diffscope.visualeditor.arrangementPanel.additionalTracks.tempo" category="Additional Tracks" catalog="org.diffscope.visualeditor.arrangementPanel.additionalTrackWidgets" icon="metronome" triggerable="false" diffscope:componentType="custom" />
        <action id="org.diffscope.visualeditor.arrangementPanel.additionalTracks.keySignature" category="Additional Tracks" catalog="org.diffscope.visualeditor.arrangementPanel.additionalTrackWidgets" icon="" triggerable="false" diffscope:componentType="custom" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.additionalTracks.label" category="Additional Tracks" catalog="org.diffscope.visualeditor.pianoRollPanel.additionalTrackWidgets" icon="tag" triggerable="false" diffscope:componentType="custom" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.additionalTracks.tempo" category="Additional Tracks" catalog="org.diffscope.visualeditor.pianoRollPanel.additionalTrackWidgets" icon="metronome" triggerable="false" diffscope:componentType="custom" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.additionalTracks.keySignature" category="Additional Tracks" catalog="org.diffscope.visualeditor.pianoRollPanel.additionalTrackWidgets" icon="" triggerable="false" diffscope:componentType="custom" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.additionalTracks.clip" category="Additional Tracks" catalog="org.diffscope.visualeditor.pianoRollPanel.additionalTrackWidgets" icon="" triggerable="false" diffscope:componentType="custom" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.additionalTracks.phoneme" category="Additional Tracks" catalog="org.diffscope.visualeditor.pianoRollPanel.bottomAdditionalTrackWidgets" icon="" triggerable="false" diffscope:componentType="custom" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.additionalTracks.parameter" category="Additional Tracks" catalog="org.diffscope.visualeditor.pianoRollPanel.bottomAdditionalTrackWidgets" icon="parameter_view" triggerable="false" diffscope:componentType="custom" />
        <action id="org.diffscope.visualeditor.pianoRollPanel.additionalTracks.dynamicMixing" category="Additional Tracks" catalog="org.diffscope.visualeditor.pianoRollPanel.bottomAdditionalTrackWidgets" text="Voice blending" icon="circle_hint_half_vertical" triggerable="false" diffscope:componentType="custom" />

        <menu id="org.diffscope.visualeditor.view.scroll" />
        <group id="org.diffscope.visualeditor.view.scrollActions" />
        <group id="org.diffscope.visualeditor.view.scrollPageActions" />
        <group id="org.diffscope.visualeditor.view.scrollToActions" />
        <menu id="org.diffscope.visualeditor.view.zoom" />
        <menu id="org.diffscope.visualeditor.arrangementPanelToolBar" topLevel="true" />
        <group id="org.diffscope.visualeditor.arrangementPanelToolBar.toolActions" />
        <group id="org.diffscope.visualeditor.arrangementPanelToolBar.snapActions" />
        <menu id="org.diffscope.visualeditor.pianoRollPanelToolBar" topLevel="true" />
        <group id="org.diffscope.visualeditor.pianoRollPanelToolBar.toolActions" />
        <group id="org.diffscope.visualeditor.pianoRollPanelToolBar.snapActions" />
        <group id="org.diffscope.visualeditor.pianoRollPanelToolBar.editingClipActions" />
        <menu id="org.diffscope.visualeditor.mixerPanelToolBar" topLevel="true" />
        <group id="org.diffscope.visualeditor.mixerPanelToolBar.toolActions" />
        <menu id="org.diffscope.visualeditor.arrangementPanelTimelineToolBar" topLevel="true" />
        <menu id="org.diffscope.visualeditor.pianoRollPanelTimelineToolBar" topLevel="true" />
        <phony id="org.diffscope.core.workspacePanelWidgets" />
    </items>

    <layouts>
        <menu id="org.diffscope.visualeditor.view.scroll">
            <group id="org.diffscope.visualeditor.view.scrollActions">
                <action id="org.diffscope.visualeditor.view.scrollUp" />
                <action id="org.diffscope.visualeditor.view.scrollDown" />
                <action id="org.diffscope.visualeditor.view.scrollLeft" />
                <action id="org.diffscope.visualeditor.view.scrollRight" />
            </group>
            <group id="org.diffscope.visualeditor.view.scrollPageActions">
                <action id="org.diffscope.visualeditor.view.scrollUpPage" />
                <action id="org.diffscope.visualeditor.view.scrollDownPage" />
                <action id="org.diffscope.visualeditor.view.scrollLeftPage" />
                <action id="org.diffscope.visualeditor.view.scrollRightPage" />
            </group>
            <group id="org.diffscope.visualeditor.view.scrollToActions">
                <action id="org.diffscope.visualeditor.view.scrollToTop" />
                <action id="org.diffscope.visualeditor.view.scrollToBottom" />
                <action id="org.diffscope.visualeditor.view.scrollToLeftmost" />
                <action id="org.diffscope.visualeditor.view.scrollToRightmost" />
                <separator />
                <action id="org.diffscope.visualeditor.view.scrollToPlaybackPosition" />
                <action id="org.diffscope.visualeditor.view.scrollToCurrentItem" />
            </group>
        </menu>
        <menu id="org.diffscope.visualeditor.view.zoom">
            <action id="org.diffscope.visualeditor.view.verticalZoomIn" />
            <action id="org.diffscope.visualeditor.view.verticalZoomOut" />
            <action id="org.diffscope.visualeditor.view.horizontalZoomIn" />
            <action id="org.diffscope.visualeditor.view.horizontalZoomOut" />
            <separator />
            <action id="org.diffscope.visualeditor.view.resetVerticalScale" />
            <action id="org.diffscope.visualeditor.view.resetHorizontalScale" />
        </menu>
        <menu id="org.diffscope.visualeditor.arrangementPanelToolBar">
            <group id="org.diffscope.visualeditor.arrangementPanelToolBar.toolActions">
                <action id="org.diffscope.visualeditor.arrangementPanel.pointerTool" />
                <action id="org.diffscope.visualeditor.arrangementPanel.pencilTool" />
                <action id="org.diffscope.visualeditor.arrangementPanel.scissorTool" />
                <action id="org.diffscope.visualeditor.arrangementPanel.selectTool" />
                <action id="org.diffscope.visualeditor.arrangementPanel.handTool" />
            </group>
            <group id="org.diffscope.visualeditor.arrangementPanelToolBar.snapActions">
                <action id="org.diffscope.visualeditor.arrangementPanel.snap" />
            </group>
            <stretch />
            <action id="org.diffscope.visualeditor.arrangementPanel.autoPageScrolling" />
        </menu>
        <menu id="org.diffscope.visualeditor.pianoRollPanelToolBar">
            <group id="org.diffscope.visualeditor.pianoRollPanelToolBar.toolActions">
                <action id="org.diffscope.visualeditor.pianoRollPanel.pointerTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.pencilTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.scissorTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.selectTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.pitchPencilTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.pitchLineTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.pitchFixingTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.pitchEraserTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.pitchRangeSelectTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.pitchPointerTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.pitchPenTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.pitchConvertTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.pitchAnchorSelectTool" />
                <action id="org.diffscope.visualeditor.pianoRollPanel.handTool" />
            </group>
            <group id="org.diffscope.visualeditor.pianoRollPanelToolBar.snapActions">
                <action id="org.diffscope.visualeditor.pianoRollPanel.snap" />
            </group>
            <group id="org.diffscope.visualeditor.pianoRollPanelToolBar.editingClipActions">
                <action id="org.diffscope.visualeditor.pianoRollPanel.editingClip" />
            </group>
            <action id="org.diffscope.visualeditor.pianoRollPanel.highlightScale" />
            <stretch />
            <action id="org.diffscope.visualeditor.pianoRollPanel.bottomAdditionalTracks" />
            <action id="org.diffscope.visualeditor.pianoRollPanel.autoPageScrolling" />
        </menu>
        <menu id="org.diffscope.visualeditor.mixerPanelToolBar">
            <group id="org.diffscope.visualeditor.mixerPanelToolBar.toolActions">
                <action id="org.diffscope.visualeditor.mixerPanel.pointerTool" />
                <action id="org.diffscope.visualeditor.mixerPanel.handTool" />
            </group>
            <stretch />
        </menu>
        <menu id="org.diffscope.visualeditor.arrangementPanelTimelineToolBar">
            <stretch />
            <action id="org.diffscope.visualeditor.arrangementPanel.additionalTracks" />
        </menu>
        <menu id="org.diffscope.visualeditor.pianoRollPanelTimelineToolBar">
            <action id="org.diffscope.visualeditor.pianoRollPanel.showTrackSelector" />
            <stretch />
            <action id="org.diffscope.visualeditor.pianoRollPanel.additionalTracks" />
        </menu>
    </layouts>

    <insertions>
        <insertion target="org.diffscope.core.view" anchor="last">
            <menu id="org.diffscope.visualeditor.view.scroll" />
        </insertion>
        <insertion target="org.diffscope.core.view" anchor="last">
            <menu id="org.diffscope.visualeditor.view.zoom" />
        </insertion>
    </insertions>

</actionExtension>
